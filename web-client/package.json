{
  "name": "alsaqar-erp-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "desktop:dev": "concurrently -k \"vite --port=3000 --host=127.0.0.1\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build": "vite build",
    "desktop:dir": "vite build && electron-builder --dir",
    "desktop:dist": "vite build && electron-builder --win nsis",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','server.js','release']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.a7026331145cominfo.alsaqarerp",
    "productName": "AlSaqar ERP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AlSaqarERP-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AlSaqar ERP",
      "installerLanguages": [
        "en_US"
      ]
    }
  }
}
